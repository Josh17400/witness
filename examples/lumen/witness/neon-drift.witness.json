[
  { "name": "space on the title screen starts level 1",
    "input": "space@0.5",
    "steps": [ { "at": 0.3, "expect": ["state.scene == 'Title'"] },
               { "at": 1, "expect": ["state.scene == 'Level'", "state.globals.level_no == 0", "count('Runner') == 1"] } ] },
  { "name": "holding right runs the runner along the floor",
    "scene": "Level", "params": { "n": 0 }, "input": "right@0.5-1.5",
    "steps": [ { "at": 0.4, "expect": ["approx(first('Runner').pos[0], 264, 1)", "first('Runner').grounded"] },
               { "at": 1.6, "expect": ["first('Runner').pos[0] > 500", "state.globals.deaths == 0"], "shot": "neon-run.png" } ] },
  { "name": "running into a coin collects it",
    "scene": "Level", "params": { "n": 0 }, "input": "right@0.6-1.4",
    "steps": [ { "at": 0.5, "call": ["teleport", "Runner", 740, 130] },
               { "at": 1.5, "expect": ["state.globals.coins == 1", "count('Coin') == 5"] } ] },
  { "name": "falling off the map costs a life and respawns the runner",
    "scene": "Level", "params": { "n": 0 },
    "steps": [ { "at": 0.5, "call": ["teleport", "Runner", 264, -300] },
               { "at": 2, "expect": ["state.globals.deaths == 1", "count('Runner') == 1"] } ] },
  { "name": "touching the portal advances to the next level",
    "scene": "Level", "params": { "n": 0 },
    "steps": [ { "at": 0.5, "call": ["teleport", "Runner", 1944, 312] },
               { "at": 2.5, "expect": ["state.globals.level_no == 1", "state.scene == 'Level'"] } ] },
  { "name": "goto switches scenes and the run is seeded",
    "seed": 9,
    "steps": [ { "at": 0.2, "call": ["goto", "Victory"], "expect": ["state.scene == 'Victory'", "count('Star') == 0"] } ] }
]
