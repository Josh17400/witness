<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Coins</RootNamespace>
    <AssemblyName>Coins</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- The adapter is used straight from adapters/csharp, exactly as a game would copy it in. -->
    <Compile Include="../../adapters/csharp/Witness.cs" Link="witness/Witness.cs" />
  </ItemGroup>

</Project>
