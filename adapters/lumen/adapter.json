{
  "id": "lumen",
  "title": "Lumen (.lum games): a bridge onto Lumen's built-in test API through its Electron shell",
  "languages": ["lumen"],
  "detect": {
    "files": ["game.lum"],
    "globs": ["*.lum", "src/**/*.lum"],
    "contains": [{ "glob": "*.lum", "text": "game {" }]
  },
  "priority": 20,
  "install": [
    { "from": "witness-lumen.mjs", "to": "witness/witness-lumen.mjs" },
    { "from": "lumen-replay.mjs", "to": "witness/lumen-replay.mjs" }
  ],
  "launch": { "command": "node", "args": ["witness/witness-lumen.mjs", "game.lum"] },
  "guide": "GUIDE.md",
  "verified": "local"
}
