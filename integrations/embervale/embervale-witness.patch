+std::string witnessJsonString(const std::function<void(witness::Json&)>& fill) {
+  witness_json w{};
+  witness::Json j(&w);
+  fill(j);
+  std::string s = w.buf && !w.failed ? std::string(w.buf, w.len) : std::string();
+  std::free(w.buf);
+  return s;
+}
