+int witness_key_down(const char *name) {
+    char k[32];
+    int i;
+    witness_key_normalize(name, k, sizeof k);
+    for (i = 0; i < witness__g.key_count; i++) if (strcmp(witness__g.keys[i], k) == 0) return 1;
+    return 0;
+}
