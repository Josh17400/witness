[
  { "name": "cardsfx: a tap call at the time of a capture makes / resumes the context",
    "steps": [ { "at": 0.2 }, { "at": 0.2, "call": [["tap", ".card"], ["play", 1]] }, { "at": 0.6 }, { "at": 1.0, "expect": ["state.played == 2"] } ] },
  { "name": "cardsfx: deal by tap, play by tap and by call",
    "input": "click:70,40@0.3, click:50,145@1.1, click:190,145@1.9",
    "steps": [ { "at": 0.2 },
               { "at": 0.5 }, { "at": 1.0, "expect": ["state.dealt == 5"] },
               { "at": 1.5, "call": ["play", 3] }, { "at": 1.7 }, { "at": 2.0 }, { "at": 2.6, "expect": ["state.played == 3", "state.ai == 3"] } ] },
  { "name": "cardsfx: calls only",
    "steps": [ { "at": 0.1, "call": ["deal"] }, { "at": 0.4 }, { "at": 0.73, "call": ["play", 1] }, { "at": 1.0 },
               { "at": 1.37, "call": [["play", 2], ["play", 4]] }, { "at": 1.9, "expect": ["state.played == 3", "state.sfx > 10"] } ] }
]
